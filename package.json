{
  "name": "changegraph",
  "version": "0.1.0",
  "private": true,
  "description": "Semantic-delta verification system for validating software changes",
  "scripts": {
    "build": "pnpm -r run build",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc -b",
    "lint": "eslint packages apps --ext .ts,.tsx",
    "dev:web": "pnpm --filter @changegraph/web dev",
    "dev:worker": "pnpm --filter @changegraph/worker dev",
    "cli": "pnpm --filter @changegraph/cli start"
  },
  "devDependencies": {
    "@changegraph/attestations": "workspace:*",
    "@changegraph/fixtures": "workspace:*",
    "@changegraph/obligations": "workspace:*",
    "@changegraph/proof-memory": "workspace:*",
    "@changegraph/semantic-contract": "workspace:*",
    "@changegraph/semantic-delta": "workspace:*",
    "@changegraph/verifier-fuzz": "workspace:*",
    "@changegraph/verifier-symbolic": "workspace:*",
    "@types/node": "^22.10.0",
    "typescript": "^5.7.2",
    "vitest": "^2.1.8",
    "eslint": "^9.16.0",
    "@typescript-eslint/eslint-plugin": "^8.18.0",
    "@typescript-eslint/parser": "^8.18.0"
  },
  "engines": {
    "node": ">=20"
  },
  "packageManager": "pnpm@9.15.0"
}
