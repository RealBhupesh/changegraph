# ChangeGraph Configuration (no secrets)

# Database
DATABASE_URL=postgresql://changegraph:changegraph@localhost:5432/changegraph

# Artifact storage
ARTIFACT_STORE=local
ARTIFACT_STORE_PATH=.changegraph/artifacts

# Worker
WORKER_PROVIDER=local
WORKER_MAX_MEMORY_MB=512
WORKER_MAX_CPU_MS=30000
WORKER_CASE_TIMEOUT_MS=5000
WORKER_RUN_DEADLINE_MS=300000

# Symbolic verifier (optional)
Z3_PATH=
Z3_VERSION=

# GitHub App (optional - for live integration)
GITHUB_APP_ID=
GITHUB_APP_PRIVATE_KEY_PATH=
GITHUB_WEBHOOK_SECRET=

# Signing (optional)
SIGNING_PROVIDER=none
SIGNING_KEY_PATH=

# Web
PORT=3000
NEXT_PUBLIC_API_URL=http://localhost:3000
